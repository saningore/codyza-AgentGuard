{
  "name": "agentguard",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:up": "docker compose up -d",
    "db:wait": "node db/wait.mjs",
    "db:migrate": "node db/migrate.mjs",
    "db:seed": "tsx db/seed.ts",
    "db:reset": "node db/migrate.mjs --reset && tsx db/seed.ts",
    "setup": "docker compose up -d && node db/wait.mjs && node db/migrate.mjs --reset && tsx db/seed.ts",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "check:ready": "node db/check-ready.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "next": "^15.5.6",
    "otpauth": "^9.4.0",
    "postgres": "^3.4.7",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "^4.1.14",
    "@types/node": "^24.7.0",
    "@types/react": "^19.1.15",
    "@types/react-dom": "^19.1.9",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
