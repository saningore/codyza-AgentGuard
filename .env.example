# Local Docker defaults. Replace every value in a shared environment.
DATABASE_URL=postgres://agentguard_app:agentguard_app@localhost:54331/agentguard
DATABASE_URL_ADMIN=postgres://agentguard:agentguard@localhost:54331/agentguard
SESSION_PEPPER=local-session-pepper-change-me
TOKEN_PEPPER=local-token-pepper-change-me
CRON_SECRET=local-cron-secret-change-me
APP_URL=http://localhost:3000

# Optional. Password reset email is sent only when both are set.
RESEND_API_KEY=
EMAIL_FROM=

# Optional. model.complete fails with provider_not_configured until this is set.
OPENAI_API_KEY=

# Refused. The server will not boot while this is 1.
# AGENTGUARD_USE_FIXTURES=1
